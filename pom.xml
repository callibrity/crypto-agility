<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.callibrity</groupId>
    <artifactId>crypto-agility</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Crypto agility</name>
    <description>Crypto agility via envelope encryption: swap the key-wrapping algorithm without a rewrite.</description>
    <url>https://github.com/callibrity/crypto-agility</url>
    <inceptionYear>2026</inceptionYear>

    <organization>
        <name>Callibrity, Inc.</name>
        <url>https://www.callibrity.com</url>
    </organization>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/callibrity/crypto-agility</url>
        <connection>scm:git:https://github.com/callibrity/crypto-agility.git</connection>
    </scm>

    <properties>
        <!-- JDK 25: ML-KEM (JEP 496) and HKDF (JEP 510) are both built in. -->
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <bouncycastle.version>1.86</bouncycastle.version>
        <jackson.version>3.2.3</jackson.version>
        <jline.version>4.4.6</jline.version>
        <!-- Empty unless a coverage tool fills it in; the surefire configuration adds to it. -->
        <argLine/>
        <junit.version>6.1.3</junit.version>
        <google-java-format.version>1.35.0</google-java-format.version>
        <license-maven-plugin.version>5.1.1</license-maven-plugin.version>
        <spotless-maven-plugin.version>3.9.0</spotless-maven-plugin.version>
        <license.owner>Callibrity, Inc.</license.owner>
        <license.email>contactus@callibrity.com</license.email>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- HQC is not in the JDK yet. Every other algorithm here is plain JDK. -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>
        <!-- Writes the CBOM as JSON. -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <!-- Only the interactive prompt uses this. -->
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline</artifactId>
            <version>${jline.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
                <configuration>
                    <showWarnings>true</showWarnings>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <!-- JLine loads a small native library to talk to terminals; the JDK wants that access granted.
                         @{argLine} keeps anything a coverage tool adds, such as JaCoCo's agent. -->
                    <argLine>@{argLine} --enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
            <!-- ./mvnw -q compile exec:java starts the interactive demo. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.4</version>
                <configuration>
                    <mainClass>com.callibrity.cryptoagility.demo.Demo</mainClass>
                </configuration>
            </plugin>
            <!-- Formatting and license headers are checked by CI, not by every build, so a change you are
                 trying out never fails on layout. ./mvnw spotless:apply license:format fixes both. -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless-maven-plugin.version}</version>
                <configuration>
                    <java>
                        <includes>
                            <include>src/main/java/**/*.java</include>
                            <include>src/test/java/**/*.java</include>
                        </includes>
                        <googleJavaFormat>
                            <version>${google-java-format.version}</version>
                        </googleJavaFormat>
                    </java>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.mycila</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>${license-maven-plugin.version}</version>
                <configuration>
                    <properties>
                        <owner>${license.owner}</owner>
                        <email>${license.email}</email>
                        <year>2026</year>
                    </properties>
                    <licenseSets>
                        <licenseSet>
                            <header>com/mycila/maven/plugin/license/templates/APACHE-2.txt</header>
                            <includes>
                                <include>src/**/*.java</include>
                                <include>pom.xml</include>
                                <include>demo</include>
                                <include>docs/*.demo</include>
                            </includes>
                        </licenseSet>
                    </licenseSets>
                    <mapping>
                        <demo>SCRIPT_STYLE</demo>
                    </mapping>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
